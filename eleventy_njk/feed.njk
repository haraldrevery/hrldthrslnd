---
permalink: /feed.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ settings.name }}</title>
  <link>{{ settings.url }}</link>
  <description>{{ settings.description }}</description>
  <language>{{ settings.language }}</language>
  <atom:link href="{{ '/feed.xml' | absolute }}" rel="self" type="application/rss+xml"/>
  <lastBuildDate>{{ build.date | rfc822Date }}</lastBuildDate>
  {#- The fields below carry no escaping filter, deliberately. Nunjucks
      autoescaping is on (Eleventy's default) and already entity-escapes every
      interpolation, which is exactly what RSS needs. Filtering as well escaped
      the output a second time, so a title reading "Salt & Pepper" reached the
      reader as "Salt &amp;amp; Pepper". The feed was the only place this
      happened, because every other template relies on autoescape alone. -#}
  {%- for post in collections.posts | limit(50) %}
  <item>
    <title>{{ post.data.title }}</title>
    <link>{{ post.url | absolute }}</link>
    <guid isPermaLink="true">{{ post.url | absolute }}</guid>
    <pubDate>{{ post.data.date | rfc822Date }}</pubDate>
    <description>{{ post.data.description }}</description>
    {%- for tag in post.data.tags | tagLabel %}
    <category>{{ tag }}</category>
    {%- endfor %}
  </item>
  {%- endfor %}
</channel>
</rss>
