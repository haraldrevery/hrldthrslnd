---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
{#- Driven by collections.sitemap, which is assembled in
    eleventy_binary/lib/eleventy_config.js. Filtering collections.all here
    instead is what made this file list the posts and nothing else: every page
    in eleventy_njk/ was excluded from collections.all, homepage included. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.sitemap %}
  <url>
    <loc>{{ entry.url | absolute }}</loc>
    {#- lastmod is the last MODIFIED date, and a page's `date` is when it was
        published. The two are the same until an entry is edited, so `updated:`
        in the front matter is what separates them; without one the publish date
        is still the best answer available and is what gets sent. -#}
    {%- set changed = entry.data.updated or entry.date %}
    {%- if changed %}
    <lastmod>{{ changed | isoDate }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
