{# Blog card macro.

   The whole card is clickable via .card-link::after, but only the title is a
   real anchor — so the link's accessible name is the post title and the tab
   order stays sane. Tag chips sit above the overlay (z-index) and remain
   independently clickable. #}
{% macro card(post, settings) %}
<article class="card">
  {#- An empty src is not a blank image: the browser re-requests the current
      page and paints the HTML as one. With no thumbnail the plate stays empty. -#}
  {%- set thumb = post.data.thumbnail or settings.default_image -%}
  <div class="card-media art-plate fill">
    {%- if thumb %}
    <img src="{{ thumb }}" alt=""{{ thumb | sizeAttrs | safe }} loading="lazy" decoding="async">
    {%- endif %}
  </div>

  <h3 class="card-title">
    <a class="card-link" href="{{ post.url }}">{{ post.data.title }}</a>
  </h3>

  {% if post.data.description %}
  <p class="card-excerpt">{{ post.data.description }}</p>
  {% endif %}

  <div class="card-meta">
    <time class="micro" datetime="{{ post.data.date | isoDate }}">{{ post.data.date | isoDate }}</time>
    {#- The site-wide spelling, not this page's: the chip and the page it opens
        have to read the same. Categories are appended after tags, so a post
        with three or more tags shows none of them here — raise the limit if a
        category should always be visible on a card. -#}
    {% for tag in post.data.tags | tagLabel | limit(3) %}
    <a class="tag-chip" href="/blog_tag_{{ tag | tagSlug }}.html">{{ tag }}</a>
    {% endfor %}
  </div>
</article>
{% endmacro %}

{# Index row, for the full index (full_index.njk): the date, then the title
   with the description and every subject beneath it. Takes a post or one of
   the standing pages; a page has no date or subjects and simply shows none.

   Every subject, not the first three a card shows. This row exists for
   find-in-page, and a subject left off it is one the reader cannot find.

   Only the title is a link. A card makes its whole face clickable through
   .card-link::after; a row here is text a reader may want to select and copy,
   and an overlay would take that away. #}
{% macro row(post) %}
{%- set iso = post.data.date | isoDate -%}
{%- set subjects = (post.data.tags or []) | tagLabel -%}
<article class="index-row index-row-entry">
  {#- Emitted even when empty: it is the first grid column, and leaving it out
      would pull the title into the date's place. -#}
  <p class="micro index-row-date">{% if iso %}<time datetime="{{ iso }}">{{ iso }}</time>{% endif %}</p>
  <div>
    <h3 class="index-row-title"><a class="link-underline" href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {%- if post.data.description %}
    <p class="index-row-desc">{{ post.data.description }}</p>
    {%- endif %}
    {%- if subjects.length %}
    <p class="index-row-tags">
      {%- for tag in subjects %}
      <a class="tag-chip" href="/blog_tag_{{ tag | tagSlug }}.html">{{ tag }}</a>
      {%- endfor %}
    </p>
    {%- endif %}
  </div>
</article>
{% endmacro %}
