{# Blog card macro.

   The whole card is clickable via .card-link::after, but only the title is a
   real anchor — so the link's accessible name is the post title and the tab
   order stays sane. Tag chips sit above the overlay (z-index) and remain
   independently clickable. #}
{% macro card(post, settings) %}
<article class="card">
  {#- An empty src is not a blank image: the browser re-requests the current
      page and paints the HTML as one. With no thumbnail the plate stays empty. -#}
  {%- set thumb = post.data.thumbnail or settings.default_image -%}
  <div class="card-media art-plate fill">
    {%- if thumb %}
    <img src="{{ thumb }}" alt=""{{ thumb | sizeAttrs | safe }} loading="lazy" decoding="async">
    {%- endif %}
  </div>

  <h3 class="card-title">
    <a class="card-link" href="{{ post.url }}">{{ post.data.title }}</a>
  </h3>

  {% if post.data.description %}
  <p class="card-excerpt">{{ post.data.description }}</p>
  {% endif %}

  <div class="card-meta">
    <time class="micro" datetime="{{ post.data.date | isoDate }}">{{ post.data.date | isoDate }}</time>
    {#- The site-wide spelling, not this page's: the chip and the page it opens
        have to read the same. Categories are appended after tags, so a post
        with three or more tags shows none of them here — raise the limit if a
        category should always be visible on a card. -#}
    {% for tag in post.data.tags | tagLabel | limit(3) %}
    <a class="tag-chip" href="{{ tag | tagUrl }}">{{ tag }}</a>
    {% endfor %}
  </div>
</article>
{% endmacro %}

{# Index row, for the full index (full_index.njk): the date, then the title
   with the description and every subject beneath it. Takes a post or one of
   the standing pages; a page has no date or subjects and simply shows none.

   Every subject, not the first three a card shows. This row exists for
   find-in-page, and a subject left off it is one the reader cannot find.

   Only the title is a link. A card makes its whole face clickable through
   .card-link::after; a row here is text a reader may want to select and copy,
   and an overlay would take that away. #}
{% macro row(post) %}
{%- set iso = post.data.date | isoDate -%}
{%- set subjects = (post.data.tags or []) | tagLabel -%}
<article class="index-row index-row-entry">
  {#- Emitted even when empty: it is the first grid column, and leaving it out
      would pull the title into the date's place. -#}
  <p class="micro index-row-date">{% if iso %}<time datetime="{{ iso }}">{{ iso }}</time>{% endif %}</p>
  <div>
    <h3 class="index-row-title"><a class="link-underline" href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {%- if post.data.description %}
    <p class="index-row-desc">{{ post.data.description }}</p>
    {%- endif %}
    {%- if subjects.length %}
    <p class="index-row-tags">
      {%- for tag in subjects %}
      <a class="tag-chip" href="{{ tag | tagUrl }}">{{ tag }}</a>
      {%- endfor %}
    </p>
    {%- endif %}
  </div>
</article>
{% endmacro %}

{# Category card, for the plates on the front page and /categories.html. See
   "Category cards" in input.css for the grid they sit in, why the picture is
   behind the text rather than above it, and why the frosted label below is a
   div of its own rather than a background or a pseudo-element.

   `entry` is one item of collections.categoryList — already resolved: URL,
   thumbnail, entry count and plate number are all worked out in the listings,
   so nothing about a category is decided here.

   `heading` is the level the title takes, because the same card sits under an
   h2 on the front page and directly under the page's h1 on /categories.html.

   `position` is the card's 1-based place in its grid, and it is only used to
   tell the browser how wide the picture will be drawn. Every third card
   starting with the first is the large plate — see "Category cards" in
   input.css — and at desktop width it is drawn twice as wide as the two beside
   it. `sizes` is a hint, not a promise: the remainder rules can make the last
   card of a grid wider than this says, and the cost of being wrong is one
   step of sharpness, never a broken image.

   Built like the blog card: only the title is a real link, and .card-link::after
   stretches it over the whole plate. The picture is decoration — the title is
   the link's name, and alt text would read the category out a second time. #}
{% macro category(entry, heading = "h3", position = 1) %}
{%- set lead = position % 3 == 1 -%}
{%- set sizes = "(min-width: 64rem) 62vw, (min-width: 40rem) 92vw, 88vw" if lead
                else "(min-width: 64rem) 31vw, (min-width: 40rem) 45vw, 88vw" -%}
<article class="category-card">
  <div class="category-card-media art-plate fill" aria-hidden="true">
    {%- if entry.thumbnail %}
    <img src="{{ entry.thumbnail }}" alt=""{{ entry.thumbnail | sizeAttrs | safe }}
         {%- if entry.srcset %} srcset="{{ entry.srcset }}" sizes="{{ sizes }}"{% endif %}
         loading="lazy" decoding="async">
    {%- endif %}
  </div>

  {#- The frosted label the text is set on. An element of its own, and the only
      piece of markup this card carries purely for the stylesheet — see
      "Category cards" in input.css, under CONSTRUCTION, for why it cannot be a
      background on the block below or a pseudo-element on anything. Short
      version: a backdrop-filter on the text block would shrink the whole-plate
      click target to the line of type, and an absolutely positioned pseudo
      would frost the entire picture rather than the label. -#}
  <div class="category-card-frost"></div>

  {#- The text. It sits in the same grid cell as the frost and stays
      unpositioned, which is what keeps .card-link::after stretched over the
      whole plate. -#}
  <div class="category-card-body">
    <p class="category-card-meta">
      <span class="category-card-number" aria-hidden="true">{% if entry.number < 10 %}0{% endif %}{{ entry.number }}</span>
      <span>{{ entry.count }} {% if entry.count == 1 %}entry{% else %}entries{% endif %}</span>
    </p>
    <span class="category-card-rule" aria-hidden="true"></span>

    <{{ heading }} class="category-card-title">
      <a class="card-link" href="{{ entry.href }}">{{ entry.title }}</a>
    </{{ heading }}>

    {%- if entry.description %}
    <p class="category-card-desc">{{ entry.description }}</p>
    {%- endif %}
  </div>
</article>
{% endmacro %}
